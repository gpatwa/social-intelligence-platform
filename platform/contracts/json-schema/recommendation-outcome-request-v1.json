{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://social-intelligence.example/contracts/recommendation-outcome-request-v1.json",
  "title": "Recommendation outcome request v1",
  "description": "An observational measurement attached to a human-approved or human-edited recommendation review.",
  "type": "object",
  "additionalProperties": false,
  "required": ["tenant_id", "review", "metric_name", "observed_value", "unit", "observed_at", "measurement_source", "reported_by", "idempotency_key"],
  "properties": {
    "tenant_id": {"type": "string", "minLength": 1, "maxLength": 63},
    "review": {"$ref": "recommendation-review-v1.json"},
    "metric_name": {"type": "string", "minLength": 1, "maxLength": 128},
    "observed_value": {"type": "number"},
    "baseline_value": {"type": "number"},
    "unit": {"type": "string", "minLength": 1, "maxLength": 64},
    "measurement_window_days": {"type": "integer", "minimum": 1, "maximum": 90, "default": 7},
    "measurement_source": {"type": "string", "minLength": 1, "maxLength": 128},
    "observed_at": {"type": "string", "format": "date-time"},
    "reported_by": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"},
    "idempotency_key": {"type": "string", "minLength": 1, "maxLength": 256},
    "confidence": {"enum": ["DIRECTIONAL", "MEASURED"], "default": "DIRECTIONAL"}
  }
}
