{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://social-intelligence.example/contracts/recommendation-context-request-v1.json",
  "title": "Recommendation context compile request v1",
  "description": "Bounded, no-PII inputs used to compile a draft-only reranking context.",
  "type": "object",
  "additionalProperties": false,
  "required": ["tenant_id", "decision_id", "business_objective", "market", "locale", "primary_metric", "ranked_evidence", "candidates"],
  "properties": {
    "tenant_id": {"type": "string", "minLength": 1, "maxLength": 63},
    "decision_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "business_objective": {"type": "string", "minLength": 1, "maxLength": 500},
    "market": {"type": "string", "minLength": 1, "maxLength": 120},
    "locale": {"type": "string", "minLength": 1, "maxLength": 32},
    "primary_metric": {"type": "string", "minLength": 1, "maxLength": 120},
    "action_policy": {"const": "DRAFT_AND_RECOMMEND_ONLY"},
    "max_evidence_items": {"type": "integer", "minimum": 1, "maximum": 20, "default": 5},
    "allowed_channels": {"type": "array", "maxItems": 20, "items": {"type": "string", "minLength": 1, "maxLength": 256}},
    "excluded_candidate_ids": {"type": "array", "maxItems": 20, "items": {"type": "string", "minLength": 1, "maxLength": 256}},
    "ranked_evidence": {
      "type": "array", "minItems": 1, "maxItems": 100,
      "items": {"type": "object", "additionalProperties": true, "required": ["evidence_id", "rank", "rank_score", "platform", "title", "source_url", "why_ranked"], "properties": {
        "evidence_id": {"type": "string", "minLength": 1, "maxLength": 256}, "rank": {"type": "integer", "minimum": 1}, "rank_score": {"type": "number"}, "platform": {"type": "string", "minLength": 1, "maxLength": 64}, "title": {"type": "string", "minLength": 1, "maxLength": 500}, "source_url": {"type": "string", "format": "uri", "pattern": "^https://"}, "why_ranked": {"type": "array", "maxItems": 3, "items": {"type": "string", "minLength": 1, "maxLength": 256}}
      }}
    },
    "candidates": {
      "type": "array", "minItems": 1, "maxItems": 100,
      "items": {"type": "object", "additionalProperties": false, "required": ["candidate_id", "candidate_type", "title", "description", "expected_outcome"], "properties": {
        "candidate_id": {"type": "string", "minLength": 1, "maxLength": 256}, "candidate_type": {"enum": ["product", "creative", "channel", "ai_workflow"]}, "title": {"type": "string", "minLength": 1, "maxLength": 500}, "description": {"type": "string", "minLength": 1, "maxLength": 1000}, "eligible": {"type": "boolean", "default": true}, "channels": {"type": "array", "maxItems": 20, "items": {"type": "string", "minLength": 1, "maxLength": 256}}, "expected_outcome": {"type": "string", "minLength": 1, "maxLength": 256}, "constraints": {"type": "array", "maxItems": 20, "items": {"type": "string", "minLength": 1, "maxLength": 256}}
      }}
    },
    "outcome_signals": {
      "type": "array", "maxItems": 100,
      "items": {"type": "object", "additionalProperties": false, "required": ["candidate_id", "metric", "value", "unit", "observed_at"], "properties": {
        "candidate_id": {"type": "string", "minLength": 1, "maxLength": 256}, "metric": {"type": "string", "minLength": 1, "maxLength": 128}, "value": {"type": "number"}, "unit": {"type": "string", "minLength": 1, "maxLength": 64}, "observed_at": {"type": "string", "minLength": 1, "maxLength": 64}, "confidence": {"type": "string", "minLength": 1, "maxLength": 64}
      }}
    }
  }
}
