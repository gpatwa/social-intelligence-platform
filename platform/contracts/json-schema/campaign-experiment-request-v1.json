{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://social-intelligence.example/contracts/campaign-experiment-request-v1.json",
  "title": "Campaign experiment request v1",
  "description": "No-PII, draft-only campaign experiment created from a human-approved recommendation review.",
  "type": "object", "additionalProperties": false,
  "required": ["tenant_id", "review", "campaign_name", "channel", "business_objective", "primary_metric", "control_definition", "treatment_definition", "comparison_method", "planned_start_at", "planned_end_at", "created_by", "idempotency_key"],
  "properties": {
    "tenant_id": {"type": "string", "minLength": 1, "maxLength": 63}, "review": {"type": "object"},
    "campaign_name": {"type": "string", "minLength": 1, "maxLength": 256}, "channel": {"type": "string", "minLength": 1, "maxLength": 128},
    "business_objective": {"type": "string", "minLength": 1, "maxLength": 500}, "primary_metric": {"type": "string", "minLength": 1, "maxLength": 128},
    "control_definition": {"type": "string", "minLength": 1, "maxLength": 1000}, "treatment_definition": {"type": "string", "minLength": 1, "maxLength": 1000},
    "comparison_method": {"enum": ["RANDOMIZED_AB_TEST", "HOLDOUT", "PRE_POST"]}, "planned_start_at": {"type": "string", "format": "date-time"}, "planned_end_at": {"type": "string", "format": "date-time"},
    "created_by": {"type": "string", "minLength": 1, "maxLength": 128}, "idempotency_key": {"type": "string", "minLength": 1, "maxLength": 256}, "target_lift_pct": {"type": "number", "minimum": -100, "default": 10}
  }
}
