{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/gpatwa/social-intelligence-platform/main/platform/contracts/json-schema/agent-artifact-v1.json",
  "title": "Agent Artifact v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact_id", "schema_version", "run_id", "task_id", "agent_role",
    "created_at", "summary", "claims", "recommendations", "risks", "confidence", "status"
  ],
  "properties": {
    "artifact_id": {"type": "string", "minLength": 1},
    "schema_version": {"const": "1.0"},
    "run_id": {"type": "string", "minLength": 1},
    "task_id": {"type": "string", "minLength": 1},
    "opportunity_id": {"type": ["string", "null"]},
    "agent_role": {"enum": ["research", "analyst", "strategist", "creative", "experiment", "critic", "supervisor"]},
    "provider": {"type": ["string", "null"]},
    "model": {"type": ["string", "null"]},
    "prompt_version": {"type": ["string", "null"]},
    "created_at": {"type": "string", "format": "date-time"},
    "summary": {"type": "string", "minLength": 1},
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["statement", "evidence_ids", "confidence"],
        "properties": {
          "statement": {"type": "string", "minLength": 1},
          "evidence_ids": {"type": "array", "items": {"type": "string"}, "minItems": 1},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1}
        }
      }
    },
    "recommendations": {"type": "array", "items": {"type": "string"}},
    "risks": {"type": "array", "items": {"type": "string"}},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "status": {"enum": ["draft", "validated", "rejected"]}
  }
}
