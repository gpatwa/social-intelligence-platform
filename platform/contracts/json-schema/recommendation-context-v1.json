{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://social-intelligence.example/contracts/recommendation-context-v1.json",
  "title": "Recommendation context v1",
  "description": "Deterministic, draft-only context packet for a future bounded reranker.",
  "type": "object",
  "additionalProperties": false,
  "required": ["context_id", "schema_version", "context_version", "tenant_id", "decision_id", "stage", "status", "business_context", "evidence", "candidate_set", "excluded_candidates", "outcome_signals", "reranking_context", "guardrails", "approval_required", "causality_claim", "mutation"],
  "properties": {
    "context_id": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "schema_version": {"const": "1.0"}, "context_version": {"const": "recommendation-context-v1"},
    "tenant_id": {"type": "string", "minLength": 1, "maxLength": 63}, "decision_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "stage": {"const": "INTERNAL_STAGING"}, "status": {"const": "READY_FOR_RERANK"},
    "business_context": {"type": "object", "additionalProperties": false, "required": ["business_objective", "market", "locale", "primary_metric"], "properties": {"business_objective": {"type": "string"}, "market": {"type": "string"}, "locale": {"type": "string"}, "primary_metric": {"type": "string"}}},
    "evidence": {"type": "array", "minItems": 1, "maxItems": 20, "items": {"type": "object", "additionalProperties": false, "required": ["evidence_id", "rank", "rank_score", "platform", "title", "source_url", "why_ranked"], "properties": {"evidence_id": {"type": "string"}, "rank": {"type": "integer", "minimum": 1}, "rank_score": {"type": "number"}, "platform": {"type": "string"}, "title": {"type": "string"}, "source_url": {"type": "string", "format": "uri", "pattern": "^https://"}, "why_ranked": {"type": "array", "items": {"type": "string"}}}}},
    "candidate_set": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "excluded_candidates": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["candidate_id", "reason"], "properties": {"candidate_id": {"type": "string"}, "reason": {"type": "string"}}}},
    "outcome_signals": {"type": "array", "items": {"type": "object"}},
    "reranking_context": {"type": "object", "additionalProperties": false, "required": ["candidate_scope", "evidence_requirement", "decision_policy"], "properties": {"candidate_scope": {"type": "string"}, "evidence_requirement": {"type": "string"}, "decision_policy": {"const": "DRAFT_AND_RECOMMEND_ONLY"}}},
    "guardrails": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "approval_required": {"const": true}, "causality_claim": {"const": "none"}, "mutation": {"const": "none"}
  }
}
