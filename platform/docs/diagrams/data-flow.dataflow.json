  "nodes": [
    {
      "id": "youtube",
      "type": "external",
      "label": "YouTube Data API",
      "sublabel": "keyword + channel rules",
      "stage": 0,
      "row": 0,
      "tag": "daily quota"
    },
    {
      "id": "x-api",
      "type": "external",
      "label": "X API v2",
      "sublabel": "recent search",
      "stage": 0,
      "row": 2,
      "tag": "pay per read"
    },
    {
      "id": "collectors",
      "type": "backend",
      "label": "Collectors",
      "sublabel": "GitHub Actions, hourly",
      "stage": 1,
      "row": 1,
      "tag": "budgets enforced"
    },
    {
      "id": "raw-volume",
      "type": "database",
      "label": "Raw volume",
      "sublabel": "immutable NDJSON",
      "stage": 2,
      "row": 0,
      "tag": "at-least-once"
    },
    {
      "id": "medallion",
      "type": "database",
