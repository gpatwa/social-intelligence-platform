  "flows": [
    {
      "id": "videos",
      "from": "youtube",
      "to": "collectors",
      "label": "videos + stats",
      "variant": "default"
    },
    {
      "id": "posts",
      "from": "x-api",
      "to": "collectors",
      "label": "posts",
      "classification": "billed per read",
      "variant": "default"
    },
    {
      "id": "land",
      "from": "collectors",
      "to": "raw-volume",
      "label": "event batches",
      "variant": "emphasis"
    },
    {
      "id": "ingest",
      "from": "raw-volume",
      "to": "medallion",
      "label": "Auto Loader",
      "variant": "emphasis",
      "labelDy": 24
    },
    {
      "id": "rank",
      "from": "medallion",
      "to": "evidence",
      "label": "posts + metrics",
      "variant": "emphasis",
      "route": "vertical-channel",
      "channelX": 680,
      "labelAt": [
        680,
        214
      ]
    },
    {
      "id": "signals",
      "from": "medallion",
      "to": "opportunities",
      "label": "signal feed",
      "variant": "default"
    },
    {
      "id": "propose",
      "from": "opportunities",
      "to": "review",
      "label": "cited drafts",
      "variant": "security",
      "labelDy": 24
    },
    {
      "id": "read",
      "from": "evidence",
      "to": "mcp",
      "label": "read-only",
      "variant": "default"
    },
    {
      "id": "publish",
      "from": "opportunities",
      "to": "snowflake",
      "label": "curated marts",
      "variant": "dashed"
    }
  ],
  "cards": [
    {
      "dot": "emerald",
      "title": "Collection",
      "items": [
        "Collectors run outside Databricks Free Edition and land immutable batches before moving cursors",
        "X spend is capped at 2,000 reads per day; YouTube search calls are budgeted per day"
      ]
    },
    {
      "dot": "rose",
      "title": "Governance",
      "items": [
        "Recommendations are evidence-cited drafts; a human approves before anything external happens",
        "The append boundary authenticates the reviewer, checks tenant and lineage, and writes once"
      ]
    },
    {
      "dot": "orange",
      "title": "Serving",
      "items": [
        "Databricks is the system of record; Snowflake serves curated read-only marts",
        "MCP tools read tenant-scoped evidence and never mutate state"
      ]
    }
  ]
}